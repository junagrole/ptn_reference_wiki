filters:
  and:
    - '!file.inFolder("Templates")'
    - Content == "Incident"
    - note["NF"] >= 26
    - note["NF"] <= 60
views:
  - type: table
    name: All Incidents
    groupBy:
      property: NF
      direction: ASC
    order:
      - file.name
      - Month
      - Day
      - Kind
      - Short
    sort:
      - property: NF
        direction: ASC
      - property: Month
        direction: ASC
      - property: Day
        direction: ASC
    columnSize:
      file.name: 118
      note.Month: 75
      note.Day: 87
      note.Kind: 104
  - type: table
    name: Only Major Incidents
    filters:
      and:
        - Major == true
    groupBy:
      property: NF
      direction: ASC
    order:
      - file.name
      - Month
      - Day
      - Kind
      - Short
    sort:
      - property: NF
        direction: ASC
      - property: Month
        direction: ASC
      - property: Day
        direction: ASC
  - type: table
    name: Only Minor Incidents
    filters:
      and:
        - Major == false
    groupBy:
      property: NF
      direction: ASC
    order:
      - file.name
      - Month
      - Day
      - Kind
      - Short
    sort:
      - property: NF
        direction: ASC
      - property: Month
        direction: ASC
      - property: Day
        direction: ASC
