filters:
  and:
    - Content == "Character"
    - '!file.inFolder("Templates")'
views:
  - type: table
    name: All characters
    order:
      - file.name
      - Sinner
      - Gender
      - Affiliation
      - Short
  - type: table
    name: Sinners
    filters:
      and:
        - Sinner == true
    order:
      - file.name
      - Gender
      - Affiliation
      - Short
    sort: []
    columnSize:
      note.Affiliation: 128
  - type: table
    name: Non Sinners
    filters:
      and:
        - Sinner == false
    order:
      - file.name
      - Gender
      - Affiliation
      - Short
  - type: table
    name: Protagonists
    filters:
      and:
        - Storyrole == "Protagonist"
    order:
      - file.name
      - Sinner
      - Gender
      - Affiliation
      - Short
  - type: table
    name: Antagonist
    filters:
      and:
        - Storyrole == "Antagonist"
    order:
      - file.name
      - Sinner
      - Gender
      - Affiliation
      - Short
  - type: table
    name: Supporting
    filters:
      and:
        - Storyrole == "Supporting"
    order:
      - file.name
      - Sinner
      - Gender
      - Affiliation
      - Short
  - type: table
    name: Background
    filters:
      and:
        - Storyrole == "Background"
    order:
      - file.name
      - Sinner
      - Gender
      - Affiliation
      - Short
  - type: table
    name: Male Characters
    filters:
      and:
        - Gender == "Male"
    order:
      - file.name
      - Sinner
      - Affiliation
      - Short
  - type: table
    name: Maintenance
    order:
      - file.name
      - Affiliation
      - Content
      - State
      - Storyrole
    columnSize:
      note.Content: 138
      note.State: 223
