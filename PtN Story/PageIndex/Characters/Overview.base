filters:
  and:
    - Content == "Character"
    - '!file.inFolder("Templates")'
views:
  - type: table
    name: All characters
    order:
      - file.name
      - Sinner
      - Gender
      - Affiliation
      - description
    sort:
      - property: Sinner
        direction: ASC
  - type: table
    name: Sinners
    filters:
      and:
        - Sinner != "No"
    order:
      - file.name
      - Gender
      - Affiliation
      - description
    sort:
      - property: Affiliation
        direction: DESC
    columnSize:
      note.Affiliation: 128
  - type: table
    name: Sinners Classes
    filters:
      and:
        - Sinner != "No"
    groupBy:
      property: Sinner
      direction: ASC
    order:
      - file.name
      - Gender
      - Affiliation
      - description
    sort:
      - property: Affiliation
        direction: DESC
    columnSize:
      note.Affiliation: 128
  - type: table
    name: Non Sinners
    filters:
      and:
        - Sinner == "No"
    order:
      - file.name
      - Gender
      - Affiliation
      - description
  - type: table
    name: Protagonists
    filters:
      and:
        - Storyrole == "Protagonist"
    order:
      - file.name
      - Sinner
      - Gender
      - Affiliation
      - description
  - type: table
    name: Antagonist
    filters:
      and:
        - Storyrole == "Antagonist"
    order:
      - file.name
      - Sinner
      - Gender
      - Affiliation
      - description
  - type: table
    name: Supporting
    filters:
      and:
        - Storyrole == "Supporting"
    order:
      - file.name
      - Sinner
      - Gender
      - Affiliation
      - description
  - type: table
    name: Background
    filters:
      and:
        - Storyrole == "Background"
    order:
      - file.name
      - Sinner
      - Gender
      - Affiliation
      - description
  - type: table
    name: Male Characters
    filters:
      and:
        - Gender == "Male"
    order:
      - file.name
      - Sinner
      - Affiliation
      - description
  - type: table
    name: Maintenance
    order:
      - file.name
      - Affiliation
      - State
      - Storyrole
      - tags
    columnSize:
      note.Affiliation: 128
      note.Content: 138
      note.State: 101
