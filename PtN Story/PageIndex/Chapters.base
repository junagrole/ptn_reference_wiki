filters:
  and:
    - Content == "Chapter"
    - file.folder != "Templates"
views:
  - type: table
    name: All Chapters
    groupBy:
      property: NF
      direction: ASC
    order:
      - file.name
      - Month
      - Day
      - Arc
      - Short
    sort:
      - property: NF
        direction: ASC
      - property: Month
        direction: ASC
      - property: Day
        direction: ASC
    columnSize:
      note.Month: 99
      note.Day: 71
      note.type: 145
  - type: table
    name: Core Crisis
    filters:
      and:
        - file.tags.contains("core_crisis")
    groupBy:
      property: NF
      direction: ASC
    order:
      - file.name
      - Month
      - Day
      - Arc
      - Short
    sort:
      - property: NF
        direction: ASC
      - property: Month
        direction: ASC
      - property: Day
        direction: ASC
  - type: table
    name: Eternal Nightmare
    filters:
      and:
        - Arc.contains("Eternal Nightmare")
    groupBy:
      property: NF
      direction: ASC
    order:
      - file.name
      - Month
      - Day
      - Short
    sort:
      - property: year
        direction: ASC
      - property: NF
        direction: ASC
      - property: Month
        direction: ASC
      - property: Day
        direction: ASC
