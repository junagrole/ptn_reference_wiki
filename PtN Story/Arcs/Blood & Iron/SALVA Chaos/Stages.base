filters:
  and:
    - Chapter == link("SALVA Chaos")
views:
  - type: table
    name: Overview
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - file.name
      - pov
      - tags
      - short
    sort:
      - property: Short
        direction: ASC
    columnSize:
      note.Pov: 140
  - type: table
    name: PoV
    groupBy:
      property: pov
      direction: ASC
    order:
      - file.name
      - short
  - type: table
    name: Navigation
    order:
      - file.name
      - previous
      - next
    columnSize:
      note.Previous: 353
  - type: table
    name: Meta Infos
    groupBy:
      property: state
      direction: ASC
    order:
      - file.name
      - file.ctime
      - file.mtime
      - file.folder
      - tags
    columnSize:
      file.folder: 366
