filters:
  and:
    - Content == "Chapter"
    - Arc.contains(link("Eternal Nightmare"))
views:
  - type: table
    name: Overview
    groupBy:
      property: arc
      direction: ASC
    order:
      - file.name
      - short
    sort:
      - property: NF
        direction: ASC
      - property: NF
        direction: ASC
      - property: Month
        direction: ASC
      - property: Day
        direction: ASC
    columnSize:
      file.name: 186
  - type: table
    name: Timeline
    groupBy:
      property: NF
      direction: ASC
    order:
      - file.name
      - day
      - month
      - short
    sort:
      - property: NF
        direction: ASC
      - property: Month
        direction: ASC
      - property: Day
        direction: ASC
    columnSize:
      file.name: 186
      note.month: 96
  - type: table
    name: Details
    groupBy:
      property: state
      direction: ASC
    order:
      - file.name
      - day
      - month
      - N.F.
      - file.ctime
      - file.mtime
      - tags
    sort:
      - property: NF
        direction: ASC
      - property: NF
        direction: ASC
      - property: Month
        direction: ASC
      - property: Day
        direction: ASC
    columnSize:
      file.name: 186
      note.month: 96
      note.NF: 76
      file.ctime: 166
      file.mtime: 169
