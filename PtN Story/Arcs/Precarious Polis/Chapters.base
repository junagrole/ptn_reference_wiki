filters:
  and:
    - Content == "Chapter"
    - Arc.contains(link("Precarious Polis"))
views:
  - type: table
    name: Overview
    groupBy:
      property: Category
      direction: ASC
    order:
      - file.name
      - short
    sort:
      - property: NF
        direction: ASC
      - property: NF
        direction: ASC
      - property: Month
        direction: ASC
      - property: Day
        direction: ASC
    columnSize:
      file.name: 188
  - type: table
    name: Timeline
    groupBy:
      property: NF
      direction: ASC
    order:
      - file.name
      - day
      - month
      - Category
      - Short
    sort:
      - property: NF
        direction: ASC
      - property: Month
        direction: ASC
      - property: Day
        direction: ASC
    columnSize:
      file.name: 188
      note.Category: 164
  - type: table
    name: Details
    groupBy:
      property: state
      direction: ASC
    order:
      - file.name
      - day
      - month
      - N.F.
      - Category
      - file.ctime
      - file.mtime
      - tags
    sort:
      - property: NF
        direction: ASC
      - property: NF
        direction: ASC
      - property: Month
        direction: ASC
      - property: Day
        direction: ASC
    columnSize:
      file.name: 188
      note.NF: 82
      note.Category: 164
      file.ctime: 166
      file.mtime: 169
